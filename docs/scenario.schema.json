      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "plane_id": {
          "minLength": 1,
          "title": "Plane Id",
          "type": "string"
        },
        "slot_deg": {
          "title": "Slot Deg",
          "type": "number"
        },
        "launch_batch": {
          "maximum": 3.0,
          "minimum": 1.0,
          "title": "Launch Batch",
          "type": "number"
        }
      },
      "required": [
        "id",
        "plane_id",
        "slot_deg",
        "launch_batch"
      ],
      "title": "Satellite",
      "type": "object"
