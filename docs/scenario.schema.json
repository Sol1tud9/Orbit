        "$ref": "#/$defs/GroundSite"
      },
      "title": "Ground Sites",
      "type": "array"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/Failure"
      },
      "title": "Failures",
      "type": "array"
    },
    "gateway_outages": {
      "items": {
        "$ref": "#/$defs/GatewayOutage"
      },
      "title": "Gateway Outages",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "meta",
    "environment",
    "design",
    "ground_sites",
    "failures",
    "gateway_outages"
