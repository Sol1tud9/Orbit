      "additionalProperties": true,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "raan_deg": {
          "exclusiveMaximum": 360.0,
          "minimum": 0.0,
          "title": "Raan Deg",
          "type": "number"
