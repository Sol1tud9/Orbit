{
  "$defs": {
    "Design": {
      "additionalProperties": true,
      "properties": {
        "launch_stage": {
          "maximum": 3,
          "minimum": 1,
          "title": "Launch Stage",
          "type": "integer"
        },
        "planes": {
          "items": {
            "$ref": "#/$defs/Plane"
          },
          "minItems": 1,
          "title": "Planes",
          "type": "array"
        },
        "satellites": {
          "items": {
            "$ref": "#/$defs/Satellite"
          },
          "minItems": 1,
          "title": "Satellites",
          "type": "array"
        }
      },
      "required": [
        "launch_stage",
        "planes",
        "satellites"
      ],
      "title": "Design",
      "type": "object"
    },
    "Environment": {
      "additionalProperties": true,
      "properties": {
        "altitude_km": {
          "maximum": 1200.0,
          "minimum": 200.0,
          "title": "Altitude Km",
          "type": "number"
        },
        "inclination_deg": {
          "exclusiveMinimum": 0.0,
          "maximum": 180.0,
          "title": "Inclination Deg",
          "type": "number"
        },
        "earth_angle0_deg": {
          "title": "Earth Angle0 Deg",
          "type": "number"
        },
        "horizon_s": {
          "exclusiveMinimum": 0,
          "maximum": 172800,
          "title": "Horizon S",
          "type": "integer"
        },
        "step_s": {
          "exclusiveMinimum": 0,
          "title": "Step S",
          "type": "integer"
        },
        "min_elevation_deg": {
          "exclusiveMaximum": 90.0,
          "minimum": 0.0,
          "title": "Min Elevation Deg",
          "type": "number"
        },
        "isl_range_km": {
          "exclusiveMinimum": 0.0,
          "maximum": 10000.0,
          "title": "Isl Range Km",
          "type": "number"
        },
        "target_availability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Target Availability",
          "type": "number"
        }
      },
      "required": [
        "altitude_km",
        "inclination_deg",
        "earth_angle0_deg",
        "horizon_s",
        "step_s",
        "min_elevation_deg",
        "isl_range_km",
        "target_availability"
      ],
      "title": "Environment",
      "type": "object"
    },
    "Failure": {
      "additionalProperties": true,
      "properties": {
        "satellite_id": {
          "minLength": 1,
          "title": "Satellite Id",
          "type": "string"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        }
      },
      "required": [
        "satellite_id",
        "start_s",
        "end_s"
      ],
      "title": "Failure",
      "type": "object"
    },
    "GatewayOutage": {
      "additionalProperties": true,
      "properties": {
        "gateway_id": {
          "minLength": 1,
          "title": "Gateway Id",
          "type": "string"
        },
        "start_s": {
          "title": "Start S",
          "type": "number"
        },
        "end_s": {
          "title": "End S",
          "type": "number"
        }
      },
      "required": [
        "gateway_id",
        "start_s",
        "end_s"
      ],
