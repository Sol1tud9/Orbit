  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "const": "cosmo-A-1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "environment": {
      "$ref": "#/$defs/Environment"
    },
    "design": {
      "$ref": "#/$defs/Design"
    },
    "ground_sites": {
